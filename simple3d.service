[Unit]
Description=Simple 3D Printer Web UI
After=network.target

[Service]
Type=simple
User=biqu
WorkingDirectory=/home/biqu/simple3D
# server.py = static file server + self-update API (git pull from main)
ExecStart=/usr/bin/python3 /home/biqu/simple3D/server.py --port 8080
# Always restart: server.py exits on purpose after updating itself
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
